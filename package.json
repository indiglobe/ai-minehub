{
  "name": "ai-minehub",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@repo/*",
    "dev:packages": "turbo run dev --filter=@repo/*",
    "build:apps": "turbo run build --filter=!@repo/*",
    "build:packages": "turbo run build --filter=@repo/*",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "lint:staged": "turbo run lint:staged",
    "turbo:ui": "turbo devtools --port 8520",
    "check-types": "turbo run check-types",
    "START OF MAIN SCRIPTS":"==============================",
    "build:packages:dev:apps": "turbo run build --filter=@repo/* && turbo run dev --filter=!@repo/*",
    "build:packages:dev:app:web": "turbo run build --filter=@repo/* && turbo run dev --filter=web",
    "build:packages:dev:app:socket": "turbo run build --filter=@repo/* && turbo run dev --filter=socket",
    "END OF MAIN SCRIPTS":"=============================="
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18"
  } 
}
