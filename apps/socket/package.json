{
  "name": "socket",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "pnpm format"
    ]
  },
  "scripts": {
    "dev": "tf dev",
    "clean": "rimraf ./assets",
    "preseed": "pnpm clean",
    "seed": "pnpm exec tsx ./src/helpers/seed.ts",
    "prebuild": "rimraf ./dist",
    "build": "pkgroll",
    "start": "tf run start",
    "format": "prettier --write **/* ",
    "lint:staged": "lint-staged",
    "serve:local": "http-server ./assets -p 8080"
  },
  "dependencies": {
    "better-auth": "^1.5.4",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "lint-staged": "^16.2.7",
    "pkgroll": "^2.27.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "taskforge-cli": "^1.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "keywords": [],
