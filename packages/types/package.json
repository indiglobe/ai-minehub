{
  "name": "@repo/types",
  "exports": {
    "./socket/*": {
      "require": {
        "types": "./dist/socket/*.d.cts",
        "default": "./dist/socket/*.cjs"
      },
      "import": {
        "types": "./dist/socket/*.d.mts",
        "default": "./dist/socket/*.mjs"
      }
    }
  },
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "pnpm format"
    ]
  },
  "scripts": {
    "dev": "pkgroll --watch",
    "prebuild": "rimraf ./dist",
    "build": "pkgroll",
    "lint": "eslint",
    "format": "prettier --write **/* ",
    "lint:staged": "lint-staged"
  },
  "dependencies": {},
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.15",
    "eslint": "^10.4.0",
    "lint-staged": "^16.2.7",
    "pkgroll": "^2.27.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0"
}
